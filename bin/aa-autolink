# Compile patterns once
COMPILED = [(re.compile(p), u) for p, u in LINKS]


def find_link_spans(text):
    """Yield (start, end) of every existing markdown link or image so we don't double-link inside them."""
    for m in re.finditer(r"!?\[[^\]]*\]\([^)]*\)", text):
        yield m.span()
    # Also code fences and inline code
    for m in re.finditer(r"```.*?```", text, flags=re.S):
        yield m.span()
    for m in re.finditer(r"`[^`]+`", text):
        yield m.span()
    # Headings with link-like syntax are fine; URL bare links
    for m in re.finditer(r"https?://\S+", text):
        yield m.span()


def in_excluded_span(pos, spans):
    return any(s <= pos < e for s, e in spans)


def autolink_body(body):
    """Apply LINKS to body. First occurrence per pattern only. Idempotent."""
    changes = 0
    for pat, url in COMPILED:
        spans = list(find_link_spans(body))
        for m in pat.finditer(body):
            if in_excluded_span(m.start(), spans):
                continue
            # Build replacement
            text = m.group(0)
            replacement = f"[{text}]({url})"
            body = body[: m.start()] + replacement + body[m.end():]
            changes += 1
            break  # only first occurrence per pattern per page
    return body, changes


def process_file(path):
    try:
        content = path.read_text()
    except Exception:
        return None
    # Split off frontmatter
    fm = ""
    m = re.match(r"^(---\n.*?\n---\n)", content, flags=re.S)
    if m:
        fm = m.group(1)
        body = content[m.end():]
    else:
        body = content
    # Split off AA-CITE and AA-CROSSLINK blocks (they have their own links)
    cite_match = re.search(r"<!-- AA-CITE-START -->.*?<!-- AA-CITE-END -->", body, flags=re.S)
    crosslink_match = re.search(r"<!-- AA-CROSSLINK-START -->.*?<!-- AA-CROSSLINK-END -->", body, flags=re.S)
    # Find earliest cut-off
    cut_indices = [m.start() for m in [cite_match, crosslink_match] if m]
    if cut_indices:
        cut = min(cut_indices)
        narrative = body[:cut]
        tail = body[cut:]
    else:
        narrative = body
        tail = ""
    new_narrative, n = autolink_body(narrative)
    if n == 0:
        return None
    new_content = fm + new_narrative + tail
    if new_content == content:
        return None
    path.write_text(new_content)
    return n


def main():
    EXCLUDE_DIRS = {".git", ".venv", "_site", "docs", "node_modules", "bin"}
    EXCLUDE_TOPDIRS = {"case-law"}  # case-law entries are dense reference docs, already heavily linked
    total = changed = total_links = 0
    for path in RECOVERY.rglob("*.md"):
        if any(part in EXCLUDE_DIRS for part in path.parts):
            continue
        rel = path.relative_to(RECOVERY)
        if rel.parts and rel.parts[0] in EXCLUDE_TOPDIRS:
            continue
        total += 1
        n = process_file(path)
        if n:
            changed += 1
            total_links += n
    print(f"aa-autolink: processed {total} .md files; updated {changed}; added {total_links} inline links")


if __name__ == "__main__":
    main()
