#!/usr/bin/env python3
"""Atomic GitHub push tool — Git Data API based.

All files in a single invocation become ONE atomic commit. This prevents the
race-condition where sequential single-file Contents-API commits trigger CI
between landings (e.g. JSON commit lands → CI fires → MD not yet pushed → drift
detection fails → email storm).

Usage:
  aa-push <file> [<file> ...] --msg "commit message"
  aa-push --from-stdin --msg "..."        # newline-separated paths on stdin
  aa-push --branch <name> ...             # push to branch instead of main (PR workflow)
  aa-push --base <repo-root> ...          # explicit local repo root (default: cwd)
  aa-push --token-file PATH               # default: /tmp/.aa-secrets/gh
  aa-push --repo OWNER/REPO               # default: AntiAlienate/antialienate-knowledge

Behaviour:
  - Paths must be relative to the repo root, or absolute under --base.
  - Files are committed atomically — either all land in one commit or none do.
  - For binary files, set the BINARY extension list below or it'll be detected.
  - If --branch is set and the branch does not exist, it is created from main HEAD.
  - The commit message is what arrives in git log; commit author is the token's user.
"""
from __future__ import annotations

import argparse
import base64
import json
import os
import pathlib
import sys
import urllib.error
import urllib.request

DEFAULT_REPO = "AntiAlienate/antialienate-knowledge"
DEFAULT_TOKEN = "/tmp/.aa-secrets/gh"
BINARY_EXT = {".png", ".jpg", ".jpeg", ".gif", ".webp", ".pdf", ".zip", ".woff", ".woff2", ".ttf", ".ico"}


def gh(method: str, url: str, token: str, body: dict | None = None) -> dict:
    headers = {
        "Authorization": f"token {token}",
        "Accept": "application/vnd.github+json",
        "User-Agent": "aa-push",
    }
    data = None
    if body is not None:
        headers["Content-Type"] = "application/json"
        data = json.dumps(body).encode()
    req = urllib.request.Request(url, data=data, method=method, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"{method} {url} -> {e.code}: {e.read().decode('utf-8', 'replace')}") from None


def ensure_branch(token: str, repo: str, branch: str) -> str:
    """Return the sha of the branch tip, creating from main if needed."""
    try:
        ref = gh("GET", f"https://api.github.com/repos/{repo}/git/refs/heads/{branch}", token)
        return ref["object"]["sha"]
    except RuntimeError:
        if branch == "main":
            raise
        head = gh("GET", f"https://api.github.com/repos/{repo}/git/refs/heads/main", token)
        gh("POST", f"https://api.github.com/repos/{repo}/git/refs", token,
           {"ref": f"refs/heads/{branch}", "sha": head["object"]["sha"]})
        return head["object"]["sha"]


def create_blob(token: str, repo: str, content: bytes, is_binary: bool) -> str:
    body = (
        {"content": base64.b64encode(content).decode(), "encoding": "base64"}
        if is_binary else
        {"content": content.decode("utf-8"), "encoding": "utf-8"}
    )
    return gh("POST", f"https://api.github.com/repos/{repo}/git/blobs", token, body)["sha"]


def push_atomic(token: str, repo: str, branch: str, files: list[tuple[str, bytes]], msg: str) -> str:
    """Atomically commit N files. Returns the new commit sha (12-char prefix)."""
    parent_sha = ensure_branch(token, repo, branch)
    parent_commit = gh("GET", f"https://api.github.com/repos/{repo}/git/commits/{parent_sha}", token)
    base_tree_sha = parent_commit["tree"]["sha"]

    tree_entries = []
    for repo_path, content in files:
        is_binary = pathlib.Path(repo_path).suffix.lower() in BINARY_EXT
        blob_sha = create_blob(token, repo, content, is_binary)
        tree_entries.append({"path": repo_path, "mode": "100644", "type": "blob", "sha": blob_sha})

    new_tree = gh("POST", f"https://api.github.com/repos/{repo}/git/trees", token,
                  {"base_tree": base_tree_sha, "tree": tree_entries})
    new_commit = gh("POST", f"https://api.github.com/repos/{repo}/git/commits", token,
                    {"message": msg, "tree": new_tree["sha"], "parents": [parent_sha]})
    gh("PATCH", f"https://api.github.com/repos/{repo}/git/refs/heads/{branch}", token,
       {"sha": new_commit["sha"], "force": False})
    return new_commit["sha"][:12]


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(prog="aa-push")
    p.add_argument("paths", nargs="*")
    p.add_argument("--from-stdin", action="store_true")
    p.add_argument("--msg", required=True)
    p.add_argument("--branch", default="main")
    p.add_argument("--base", default=os.environ.get("AA_REPO_ROOT", os.getcwd()))
    p.add_argument("--repo", default=DEFAULT_REPO)
    p.add_argument("--token-file", default=DEFAULT_TOKEN)
    args = p.parse_args(argv)

    paths = list(args.paths)
    if args.from_stdin:
        paths += [l.strip() for l in sys.stdin if l.strip()]
    if not paths:
        print("aa-push: no files", file=sys.stderr)
        return 2

    token = pathlib.Path(args.token_file).read_text().strip()
    base = pathlib.Path(args.base).resolve()

    files: list[tuple[str, bytes]] = []
    for p_ in paths:
        local = pathlib.Path(p_)
        if not local.is_absolute():
            local = base / local
        if not local.exists():
            print(f"FAIL missing: {local}", file=sys.stderr)
            return 1
        rel = local.resolve().relative_to(base)
        files.append((str(rel).replace(os.sep, "/"), local.read_bytes()))

    try:
        sha = push_atomic(token, args.repo, args.branch, files, args.msg)
    except RuntimeError as e:
        print(f"FAIL {e}", file=sys.stderr)
        return 1
    for repo_path, _ in files:
        print(f"OK  {repo_path}")
    print(f"COMMIT {sha} on {args.branch}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
