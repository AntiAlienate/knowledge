</main>
<footer>
  AntiAlienate Knowledge · CC BY 4.0 · Generated by <span class="code">bin/aa-analytics</span> · regenerable from <span class="code">/manifest.json</span> + JSON sidecars
</footer>
<script>{JS}</script>
</body>
</html>
"""


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(prog="aa-analytics")
    p.add_argument("--out", default=str(REPO_ROOT / "analytics.html"))
    args = p.parse_args(argv)
    data = gather()
    html = render_html(data)
    pathlib.Path(args.out).write_text(html)
    print(f"wrote {args.out} — {len(html):,} bytes")
    print(f"  therapists: {sum(len(c['entries']) for c in data['therapists'])} verified + {sum(len(c['excluded']) for c in data['therapists'])} excluded across {len(data['therapists'])} country files")
    print(f"  lawyers:    {sum(len(c['entries']) for c in data['lawyers'])} verified + {sum(len(c['excluded']) for c in data['lawyers'])} excluded across {len(data['lawyers'])} region files")
    print(f"  cases:      {len(data['cases'])}")
    print(f"  jurisdictions: {len(data['jurisdictions'])}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
